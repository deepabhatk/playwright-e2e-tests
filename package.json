{
  "name": "plawright-e2e-tests",
  "version": "1.0.0",
  "description": "Playwright E2E Tests with AI capabilities inc MCP",
  "keywords": [
    "playwright",
    "playwright-e2e-tests",
    "playwright-mcp"
  ],
  "license": "ISC",
  "author": "Deepa Bhat",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test:api": "npx playwright test --config=config/test.playwright.config.ts tests/api/users.api.spec.ts --headed",
  "test:e2e": "npx playwright test --config=config/test.playwright.config.ts tests/e2e/nopcommerce.e2e.spec.ts --headed",
    "dev:make-apmt": "npx playwright test --config=config/dev.playwright.config.ts tests/functional/make.aptmt.spec.ts --headed",
    "test:make-apmt": "npx playwright test --config=config/test.playwright.config.ts tests/functional/make.aptmt.spec.ts",
    "demo:params": "npx playwright test tests/demo/params.make.aptmt.spec.ts --headed",
    "demo:parallal": "npx playwright test --grep @demo",
    "demo:global": "npx playwright test tests/functional/login.spec.ts",
    "hooks:demo": "set DEBUG=pw:api && npx playwright test tests/demo/hooks-demo.spec.ts --headed",
    "pw-adv-cap": "set DEBUG=pw:api && npx playwright test tests/demo/pwd.adv.cap.login.spec.ts --headed",
    "debug-trace": "npx playwright test tests/demo/debug.make.aptmt.spec.ts --trace on",
    "debug-cli": "PWDEBUG=1 npx playwright test tests/demo/debug.make.aptmt.spec.ts",
    "debug-ui": "npx playwright test tests/demo/debug.make.aptmt.spec.ts --ui --headed",
    "debug": "npx playwright test tests/demo/debug.make.aptmt.spec.ts --headed",
    "test-inv": "npx playwright test tests/functional/inventory.spec.ts --headed",
    "test:multi-window": "npx playwright test tests/functional/multi.window.spec.ts --headed",
    "elem-int": "npx playwright test tests/demo/elem.making.apmy.spec.ts --headed",
    "make-apmt": "npx playwright test tests/functional/make.aptmt.spec.ts --headed",
    "demo": "npx playwright test tests/demo/mytest.spec.ts --headed",
    "demo:firefox": "npx playwright test tests/demo/mytest.spec.ts --headed project=firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.5",
    "allure-playwright": "^3.10.2",
    "chalk": "^6.0.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.2"
  }
}
